# ──────────────────────────────────────────────
# Copie ce fichier en .env.local et remplis les clés
# ──────────────────────────────────────────────

# OpenWeatherMap → https://openweathermap.org/api
OPENWEATHER_API_KEY=your_key_here

# CoinGecko (gratuit sans clé, ou Pro) → https://www.coingecko.com/api
COINGECKO_API_KEY=your_key_here

# RTE Open Data Énergie France (gratuit) → https://data.rte-france.com
RTE_CLIENT_ID=your_client_id_here
RTE_CLIENT_SECRET=your_client_secret_here

# API-Football via RapidAPI → https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_KEY=your_key_here
# Optionnel alias de la meme cle (si tu preferes ce nom)
API_FOOTBALL_KEY=your_key_here

# NewsAPI → https://newsapi.org
NEWS_API_KEY=your_key_here

# Football live tuning
# Sofascore est activé par défaut; mets false/0 pour le couper.
SOFASCORE_ENABLED=true
FOOTBALL_POLLER_LIVE_INTERVAL=20
FOOTBALL_POLLER_IDLE_INTERVAL=900

# Ville par défaut pour la météo
NEXT_PUBLIC_DEFAULT_CITY=Paris
NEXT_PUBLIC_DEFAULT_LAT=48.8566
NEXT_PUBLIC_DEFAULT_LON=2.3522
